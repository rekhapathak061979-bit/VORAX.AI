<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OmniAI Master Studio - Unlimited AI Hub</title>
    <style>
        :root {
            --bg-primary: #090d16;
            --bg-secondary: #131c31;
            --bg-card: #1b2642;
            --accent: #6366f1;
            --accent-glow: rgba(99, 102, 241, 0.4);
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --border: #2a3a5f;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        body {
            background-color: var(--bg-primary);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }
        /* Top Navigation Bar */
        header {
            background: var(--bg-secondary);
            border-bottom: 1px solid var(--border);
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo {
            font-size: 1.2rem;
            font-weight: 700;
            background: linear-gradient(90deg, #818cf8, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .nav-tabs {
            display: flex;
            gap: 8px;
        }
        .tab-btn {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-muted);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .tab-btn.active, .tab-btn:hover {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
            box-shadow: 0 0 12px var(--accent-glow);
        }

        /* Main Workspace Container */
        .workspace {
            flex: 1;
            display: none;
            flex-direction: column;
            height: calc(100vh - 60px);
            overflow: hidden;
        }
        .workspace.active {
            display: flex;
        }

        /* Chat Interface Styles */
        .chat-container {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .message {
            max-width: 85%;
            padding: 14px 18px;
            border-radius: 14px;
            font-size: 0.95rem;
            line-height: 1.5;
            word-break: break-word;
        }
        .message.user {
            background: var(--accent);
            color: #fff;
            align-self: flex-end;
            border-bottom-right-radius: 4px;
            box-shadow: 0 4px 15px var(--accent-glow);
        }
        .message.ai {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            color: var(--text-main);
            align-self: flex-start;
            border-bottom-left-radius: 4px;
        }
        .chat-input-area {
            background: var(--bg-secondary);
            border-top: 1px solid var(--border);
            padding: 15px 20px;
            display: flex;
            gap: 10px;
        }
        .chat-input-area input {
            flex: 1;
            background: var(--bg-primary);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px 16px;
            color: #fff;
            font-size: 1rem;
            outline: none;
        }
        .chat-input-area input:focus {
            border-color: var(--accent);
        }
        .send-btn {
            background: var(--accent);
            color: #fff;
            border: none;
            padding: 0 20px;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .send-btn:hover {
            opacity: 0.9;
        }

        /* Studio / Generator Views */
        .studio-container {
            flex: 1;
            overflow-y: auto;
            padding: 25px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }
        .studio-card {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .studio-card h3 {
            font-size: 1.1rem;
            color: #a5b4fc;
        }
        .studio-card textarea, .studio-card input {
            width: 100%;
            background: var(--bg-primary);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px;
            color: #fff;
            resize: none;
            font-size: 0.9rem;
            outline: none;
        }
        .studio-card button {
            background: var(--accent);
            color: #fff;
            border: none;
            padding: 10px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
        }
        .preview-box {
            background: var(--bg-primary);
            border: 1px dashed var(--border);
            border-radius: 8px;
            padding: 12px;
            min-height: 80px;
            font-size: 0.9rem;
            color: var(--text-muted);
            word-break: break-word;
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <header>
        <div class="logo">⚡ OmniAI Master</div>
        <div class="nav-tabs">
            <button class="tab-btn active" onclick="switchTab('chatTab', this)">Chat Engine</button>
            <button class="tab-btn" onclick="switchTab('imageTab', this)">Image Studio</button>
            <button class="tab-btn" onclick="switchTab('videoTab', this)">Video Script AI</button>
        </div>
    </header>

    <!-- Workspace 1: Universal Chat Engine -->
    <div id="chatTab" class="workspace active">
        <div class="chat-container" id="chatBox">
            <div class="message ai">Namaste Parth! Main aapka OmniAI Master hoon. Koi bhi sawal puchiye, coding, logic, ya strategy—main bina kisi rukawat ke poori detail mein jawab dunga.</div>
        </div>
        <div class="chat-input-area">
            <input type="text" id="userInput" placeholder="Ask anything in the universe..." onkeypress="handleKeyPress(event)">
            <button class="send-btn" onclick="sendQuery()">Send</button>
        </div>
    </div>

    <!-- Workspace 2: Image Prompt & Generation Studio -->
    <div id="imageTab" class="workspace">
        <div class="studio-container">
            <div class="studio-card">
                <h3>🎨 Advanced Image Synthesizer</h3>
                <input type="text" id="imgPrompt" placeholder="Describe the image (e.g., Cyberpunk futuristic city)">
                <button onclick="generateImage()">Generate Asset</button>
                <div class="preview-box" id="imgOutput">High-resolution image rendering pipeline ready...</div>
            </div>
        </div>
    </div>

    <!-- Workspace 3: Video & Script Generator Hub -->
    <div id="videoTab" class="workspace">
        <div class="studio-container">
            <div class="studio-card">
                <h3>🎬 Viral Video Script & Idea Hub</h3>
                <textarea id="videoTopic" rows="3" placeholder="Enter video niche or topic..."></textarea>
                <button onclick="generateVideoScript()">Generate Viral Script</button>
                <div class="preview-box" id="videoOutput">Script blueprint output will appear here...</div>
            </div>
        </div>
    </div>

    <script>
        // Tab Switcher Logic
        function switchTab(tabId, btn) {
            document.querySelectorAll('.workspace').forEach(ws => ws.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            btn.classList.add('active');
        }

        // Chat Logic with Local Intelligence Engine
        function handleKeyPress(e) {
            if (e.key === 'Enter') sendQuery();
        }

        function sendQuery() {
            const input = document.getElementById('userInput');
            const chatBox = document.getElementById('chatBox');
            const query = input.value.trim();

            if (!query) return;

            // Append User Message
            chatBox.innerHTML += `<div class="message user">${escapeHtml(query)}</div>`;
            input.value = '';
            chatBox.scrollTop = chatBox.scrollHeight;

            // Simulate High-Speed Omniscient AI Response
            setTimeout(() => {
                let aiResponse = processOmniQuery(query);
                chatBox.innerHTML += `<div class="message ai">${aiResponse}</div>`;
                chatBox.scrollTop = chatBox.scrollHeight;
            }, 400);
        }

        function processOmniQuery(q) {
            const lowerQ = q.toLowerCase();
            if (lowerQ.includes('hello') || lowerQ.includes('hi')) {
                let memories = ["Parth", "Moto G57", "Sagar MP"];
                return `Hello Parth! Aapka system fully active hai. Bataiye aaj kaunsa project ya code execute karna hai?`;
            } else if (lowerQ.includes('code') || lowerQ.includes('website')) {
                return `Ye lijiye aapke liye optimized snippet structure: <br><code style="color:#818cf8">&lt;div class="omni-card"&gt;Secure Node Active&lt;/div&gt;</code><br>Aap isme apni marzi ke mutabiq CSS aur JS add kar sakte hain.`;
            } else {
                return `Aapke query "${escapeHtml(q)}" ke liye advanced neural execution complete ho chuki hai. Yeh system bina kisi restriction ke 100% open architecture par run ho raha hai. Isme aur kya feature add karein?`;
            }
        }

        function generateImage() {
            const prompt = document.getElementById('imgPrompt').value.trim();
            const out = document.getElementById('imgOutput');
            if (!prompt) {
                out.innerHTML = "Pehle koi image prompt toh enter kijiye!";
                return;
            }
            out.innerHTML = `✨ <b>Generated Asset:</b> High-def render pipeline executed for prompt: "${escapeHtml(prompt)}". (Status: 100% Optimized for Web).`;
        }

        function generateVideoScript() {
            const topic = document.getElementById('videoTopic').value.trim();
            const out = document.getElementById('videoOutput');
            if (!topic) {
                out.innerHTML = "Pehle video ka topic ya title enter karein!";
                return;
            }
            out.innerHTML = `🔥 <b>Viral Blueprint:</b><br>1. <b>0-3s Hook:</b> "Aapne aisi cheez pehle kabhi nahi dekhi hogi!"<br>2. <b>Body:</b> Detailed breakdown of ${escapeHtml(topic)}.<br>3. <b>Call to Action:</b> Subscribe and share!`;
        }

        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, m => map[m]);
        }
    </script>
</body>
</html>

